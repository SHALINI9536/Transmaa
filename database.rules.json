{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)",
        ".write": "auth != null && auth.uid === $uid",
        "role": {
          ".validate": "newData.val() === 'customer' || newData.val() === 'driver'"
        }
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": "false"
    },
    "bookings": {
      ".read": "auth != null",
      "$bookingId": {
        ".write": "auth != null && (!data.exists() || data.child('customerId').val() === auth.uid || data.child('driverId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)"
      }
    },
    "drivers": {
      ".read": "auth != null",
      "$driverId": {
        ".write": "auth != null && (auth.uid === $driverId || root.child('admins').child(auth.uid).val() === true || auth.token.admin === true)"
      }
    }
  }
}
